---
interface Props {
  slug: string;
  title: string;
  year: number;
  type: string;
  tags?: string[];
}

const { slug, title, year, type, tags = [] } = Astro.props;
---

<article class="work-card" data-type={type} data-tags={tags.join(',')}>
  <a href={`/music/${slug}`} class="work-card__link">
    <div class="work-card__info">
      <h3 class="work-card__title">{title}</h3>
      <p class="work-card__meta">{year}&thinsp;·&thinsp;{type}</p>
    </div>
  </a>
</article>

<style>
  .work-card__link {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    transition: opacity var(--transition);
  }

  .work-card__link:hover { opacity: 0.6; }

  .work-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
    font-variation-settings: 'opsz' 12;
    line-height: 1.3;
  }

  .work-card__meta {
    font-size: 0.75rem;
    color: var(--gray-mid);
    letter-spacing: 0.04em;
  }

  .work-card.hidden { display: none; }
</style>
