---
interface Props {
  slug: string;
  title: string;
  year: number;
  type: string;
  cover?: string;
  tags?: string[];
}

const { slug, title, year, type, cover, tags = [] } = Astro.props;
---

<article class="work-card" data-type={type} data-tags={tags.join(',')}>
  <a href={`/music/${slug}`} class="work-card__link">
    <div class="work-card__img-wrap">
      {cover
        ? <img src={cover} alt={title} loading="lazy" class="work-card__img" />
        : <div class="work-card__no-cover" aria-hidden="true"></div>
      }
    </div>
    <div class="work-card__info">
      <h3 class="work-card__title">{title}</h3>
      <p class="work-card__meta">{year}&thinsp;·&thinsp;{type}</p>
    </div>
  </a>
</article>

<style>
  .work-card__link {
    display: block;
  }

  .work-card__img-wrap {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--gray-rule);
    margin-bottom: 1rem;
  }

  .work-card__img,
  .work-card__no-cover {
    width: 100%;
    height: 100%;
  }

  .work-card__img {
    object-fit: cover;
    filter: grayscale(15%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .work-card__no-cover {
    background: repeating-linear-gradient(
      45deg,
      var(--border) 0px,
      var(--border) 1px,
      transparent 1px,
      transparent 8px
    );
  }

  .work-card__link:hover .work-card__img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  .work-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
    font-variation-settings: 'opsz' 12;
    line-height: 1.3;
  }

  .work-card__meta {
    font-size: 0.75rem;
    color: var(--gray-mid);
    letter-spacing: 0.04em;
  }

  .work-card.hidden {
    display: none;
  }
</style>
