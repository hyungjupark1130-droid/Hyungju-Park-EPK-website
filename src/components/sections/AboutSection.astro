---
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'index');
const {
  long_bio = '',
  portrait,
  currently = '',
  credits_recording = [],
  cv = [],
  recent_works = [],
} = about?.data ?? {};

const bioParagraphs = long_bio.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
---

<section id="about" class="scroll-section">
  <div class="container">
    <div class="scroll-section__head" data-animate>
      <h2 class="scroll-section__title">About</h2>
      <a href="/about" class="scroll-section__more">Full bio →</a>
    </div>

    <div class="about-inner">
      <!-- Left: portrait (optional) + bio -->
      <div class="about-left">
        {
          portrait && (
            <div class="portrait-wrap" data-animate>
              <img src={portrait} alt="Hyungju Park" class="portrait" />
            </div>
          )
        }
        {
          bioParagraphs.length > 0 && (
            <div class="bio" data-animate>
              {bioParagraphs.map((para) => <p class="bio-para">{para}</p>)}
            </div>
          )
        }
      </div>

      <!-- Right: currently + cv + credits -->
      <aside class="about-sidebar">
        {
          currently && (
            <div class="currently" data-animate>
              <span class="label">Currently</span>
              <p class="currently-text">{currently}</p>
            </div>
          )
        }

        {
          cv.length > 0 && (
            <div class="list-block" data-animate>
              <h3 class="list-title">Education</h3>
              <ul class="list" role="list">
                {cv.map((entry) => (
                  <li class="list-item">
                    <span class="list-main">{entry.institution}</span>
                    <span class="list-detail">{entry.program}&thinsp;·&thinsp;{entry.years}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          credits_recording.length > 0 && (
            <div class="list-block" data-animate>
              <h3 class="list-title">Engineering Credits</h3>
              <ul class="list" role="list">
                {credits_recording.map((c) => (
                  <li class="list-item">
                    <span class="list-main">{c.project}</span>
                    <span class="list-detail">{c.role}&thinsp;·&thinsp;{c.year}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </div>
</section>

<style>
  .scroll-section {
    padding-block: 7rem;
    border-top: 1px solid var(--border);
  }

  .scroll-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 3rem;
  }

  .scroll-section__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .scroll-section__more {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color var(--transition);
  }

  .scroll-section__more:hover { color: var(--fg); }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 5rem;
    align-items: start;
  }

  /* ── Left column ── */
  .about-left {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .portrait-wrap { width: 180px; }

  .portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(20%);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bio-para {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.85;
  }

  /* ── Right sidebar ── */
  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 0.25rem;
  }

  .currently {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--fg);
  }

  .label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .currently-text {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .list-block { display: flex; flex-direction: column; gap: 0; }

  .list-title {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .list { list-style: none; }

  .list-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .list-item:first-child { border-top: 1px solid var(--border); }

  .list-main {
    font-size: 0.88rem;
    font-weight: 500;
  }

  .list-detail {
    font-size: 0.73rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .about-sidebar {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .about-sidebar { grid-template-columns: 1fr; }
  }
</style>
