---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'index');
const {
  long_bio = '',
  portrait,
  currently = '',
  credits_recording = [],
  cv = [],
} = about?.data ?? {};

const bioParagraphs = long_bio.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
---

<BaseLayout title="About" description="About Hyungju Park — musician, producer, and sound engineer.">
  <div class="about container">
    {
      portrait && (
        <div class="about__portrait-wrap" data-animate>
          <img src={portrait} alt="Hyungju Park" class="about__portrait" width="320" height="427" />
        </div>
      )
    }

    <div class="about__content">
      {
        currently && (
          <div class="about__currently" data-animate>
            <span class="label">Currently</span>
            <p class="about__currently-text">{currently}</p>
          </div>
        )
      }

      {
        bioParagraphs.length > 0 && (
          <div class="about__bio" data-animate>
            {bioParagraphs.map((para) => (
              <p class="about__para">{para}</p>
            ))}
          </div>
        )
      }

      {
        credits_recording.length > 0 && (
          <section class="about__section" data-animate>
            <h2 class="about__section-title">Engineering Credits</h2>
            <ul class="about__list" role="list">
              {credits_recording.map((c) => (
                <li class="about__list-item">
                  <span class="about__list-main">{c.project}</span>
                  <span class="about__list-detail">
                    {c.role}&thinsp;·&thinsp;{c.year}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        cv.length > 0 && (
          <section class="about__section" data-animate>
            <h2 class="about__section-title">Education</h2>
            <ul class="about__list" role="list">
              {cv.map((entry) => (
                <li class="about__list-item">
                  <span class="about__list-main">{entry.institution}</span>
                  <span class="about__list-detail">
                    {entry.program}&thinsp;·&thinsp;{entry.years}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: calc(80px + 4rem);
    padding-bottom: 6rem;
    max-width: 820px;
  }

  .about__portrait-wrap {
    margin-bottom: 4rem;
    max-width: 320px;
  }

  .about__portrait {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(20%);
  }

  .about__currently {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 3.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--fg);
  }

  .label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-mid);
  }

  .about__currently-text {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .about__para {
    font-size: clamp(1rem, 1.3vw, 1.05rem);
    line-height: 1.85;
  }

  .about__section {
    border-top: 1px solid var(--gray-rule);
    padding-top: 3rem;
    margin-top: 0;
    margin-bottom: 3rem;
  }

  .about__section-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.06em;
    margin-bottom: 2rem;
  }

  .about__list {
    list-style: none;
  }

  .about__list-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .about__list-main {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .about__list-detail {
    font-size: 0.78rem;
    color: var(--gray-mid);
    flex-shrink: 0;
  }
</style>
