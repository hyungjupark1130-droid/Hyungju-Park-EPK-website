---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const works = await getCollection('works');
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
};

const { work } = Astro.props;
const { Content } = await render(work);

const {
  title,
  year,
  type,
  role,
  cover,
  audio,
  video_url,
  external_links = [],
  credits,
  tags = [],
  description,
} = work.data;

function embedUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    if (!['https:', 'http:'].includes(parsed.protocol)) return null;
    if (parsed.hostname === 'www.youtube.com' || parsed.hostname === 'youtube.com') {
      const v = parsed.searchParams.get('v');
      return v ? `https://www.youtube.com/embed/${v}` : null;
    }
    if (parsed.hostname === 'youtu.be') {
      return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
    }
    if (parsed.hostname === 'vimeo.com' || parsed.hostname === 'www.vimeo.com') {
      return `https://player.vimeo.com/video${parsed.pathname}`;
    }
    return null;
  } catch { return null; }
}

const embedSrc = video_url ? embedUrl(video_url) : null;
---

<BaseLayout title={title} description={description}>
  <div class="detail container">
    <div class="detail__nav" data-animate>
      <a href="/music" class="back-link">← Music</a>
    </div>

    <article class="detail__body">
      <div class="detail__left" data-animate>
        <div class="detail__cover-wrap">
          {cover
            ? <img src={cover} alt={title} class="detail__cover" width="600" height="600" />
            : <div class="detail__cover-placeholder" aria-hidden="true"></div>
          }
        </div>
      </div>

      <div class="detail__right" data-animate>
        <div class="detail__meta-row">
          <span class="detail__type-badge">{type}</span>
          <span class="detail__year">{year}</span>
        </div>

        <h1 class="detail__title">{title}</h1>

        {role && <p class="detail__role">{role}</p>}

        {audio && <AudioPlayer src={audio} title={title} />}

        {
          description && (
            <div class="detail__desc">
              <p>{description}</p>
            </div>
          )
        }

        {
          work.body?.trim() && (
            <div class="detail__prose prose">
              <Content />
            </div>
          )
        }

        {
          credits && (
            <div class="detail__section">
              <h3 class="detail__label">Credits</h3>
              <p class="detail__credits-text">{credits}</p>
            </div>
          )
        }

        {
          tags.length > 0 && (
            <div class="detail__section detail__tags">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }

        {
          external_links.length > 0 && (
            <div class="detail__section detail__ext-links">
              {external_links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ext-link"
                >
                  {link.label} ↗
                </a>
              ))}
            </div>
          )
        }

        {
          embedSrc && (
            <div class="detail__section detail__video">
              <iframe
                src={embedSrc}
                title={`${title} — video`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .detail {
    padding-top: calc(80px + 3rem);
    padding-bottom: 6rem;
  }

  .detail__nav {
    margin-bottom: 3rem;
  }

  .back-link {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-mid);
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--black);
  }

  .detail__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .detail__left {
    position: sticky;
    top: 100px;
  }

  .detail__cover-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--gray-rule);
  }

  .detail__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(10%);
  }

  .detail__cover-placeholder {
    width: 100%;
    height: 100%;
    background: var(--raised);
  }

  .detail__right {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .detail__meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .detail__type-badge {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--gray-rule);
    color: var(--gray-mid);
  }

  .detail__year {
    font-size: 0.85rem;
    color: var(--gray-mid);
  }

  .detail__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .detail__role {
    font-size: 0.88rem;
    color: var(--gray-mid);
    margin-bottom: 1rem;
  }

  .detail__desc {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .detail__prose {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .detail__section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--gray-rule);
  }

  .detail__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-mid);
    margin-bottom: 0.75rem;
  }

  .detail__credits-text {
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .detail__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--gray-rule);
    color: var(--gray-mid);
  }

  .detail__ext-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .ext-link {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color var(--transition), color var(--transition);
  }

  .ext-link:hover {
    color: var(--muted);
    border-color: var(--muted);
    opacity: 0.8;
  }

  .detail__video {
    aspect-ratio: 16 / 9;
  }

  .detail__video iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 768px) {
    .detail__body {
      grid-template-columns: 1fr;
    }

    .detail__left {
      position: static;
    }
  }
</style>
